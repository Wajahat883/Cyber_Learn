# CyberLearn AI configuration.
# Copy to `.env` and fill in values. Never commit `.env`.
# Docker Compose reads this file too; values for MONGODB_URI / REDIS_URL are
# overridden inside the containers so they point at the compose services.

NODE_ENV=development
PORT=4000
# Origin of the frontend (CORS + cookie checks). Vite dev server by default.
APP_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/cyberlearn
# Leave empty to run background jobs in-process without Redis (development only).
REDIS_URL=redis://localhost:6379
# true = the API process also runs the generation worker (handy in development).
RUN_WORKER_IN_PROCESS=true

# Long random string (e.g. `openssl rand -hex 32`). Required in production and
# for `docker compose` (published placeholder values are rejected).
SESSION_SECRET=
# Encrypts stored AI provider API keys. Required in production; use a different
# random value from SESSION_SECRET. (Upgrading an install that ran without it:
# set it to the old SESSION_SECRET value so saved keys stay readable.)
SECRETS_KEY=
# Set to true when serving over HTTPS (a warning is logged in production otherwise).
COOKIE_SECURE=false

# --- AI text generation -------------------------------------------------------
# mock               = offline heuristic generator, no API key needed
# openai-compatible  = OpenCode Zen, OpenAI, OpenRouter, Ollama, LM Studio ...
# anthropic          = Claude via the Anthropic API
AI_TEXT_PROVIDER=mock
AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_REQUEST_TIMEOUT_MS=120000
# Per-user daily AI ceiling (model calls, and characters sent+received ≈ 4 per token). 0 = unlimited.
AI_DAILY_CALL_LIMIT=400
AI_DAILY_CHAR_LIMIT=4000000
# Optional daily token ceiling (input + output tokens reported by the provider). Empty/0 = unlimited.
AI_DAILY_TOKEN_LIMIT=
# true = grade open quiz answers with the AI against a rubric (a cheap model where possible).
# Off by default; falls back to deterministic word-overlap grading on any error.
AI_RUBRIC_GRADING=false

# --- Embeddings (optional) ------------------------------------------------------
# Hybrid retrieval for Ask My Notes. Empty = keyword/BM25 ranking only.
# openai-compatible = any /embeddings endpoint (OpenAI, Ollama, LM Studio ...)
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# Monitoring: set a token to enable GET /api/v1/metrics (Prometheus format, "Authorization: Bearer <token>").
METRICS_TOKEN=
# Standalone worker only: expose its metrics on this port (0 = off).
METRICS_PORT=0

# --- Image generation ---------------------------------------------------------
# placeholder = generated SVG concept illustration (offline)
# openai-compatible = any /images/generations endpoint
AI_IMAGE_PROVIDER=placeholder
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# --- Narration / text-to-speech -----------------------------------------------
# browser = the player speaks with the browser's speech engine (offline)
# openai-compatible = any /audio/speech endpoint, audio stored as an asset
AI_SPEECH_PROVIDER=browser
AI_SPEECH_BASE_URL=
AI_SPEECH_API_KEY=
AI_SPEECH_MODEL=
AI_SPEECH_VOICE=

# --- File storage -------------------------------------------------------------
# local = private directory on disk (a Docker volume in compose)
# s3    = any S3-compatible service (MinIO, AWS S3, Cloudflare R2 ...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
# Also the MinIO root credentials with `--profile s3` (required, no defaults).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# MinIO console, bound to 127.0.0.1 only.
MINIO_CONSOLE_PORT=9001

# --- Limits -------------------------------------------------------------------
MAX_CONCURRENT_GENERATIONS_PER_USER=2
# Generations without a worker heartbeat for this long are marked failed (retryable).
GENERATION_STALE_MINUTES=10
LOG_LEVEL=info
